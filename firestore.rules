rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Single source of truth for authorized admin accounts (strictly synchronized with src/config/admin.ts)
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.lower() in [
          'jagannathsing777@gmail.com',
          'admin.aurevyxon@gmail.com',
          'admin@aurevyxon.com'
        ]
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. USER DOMAIN
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 2. SELLER DOMAIN
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isOwner(sellerId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(sellerId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'kycStatus', 'kyc_status']) || 
         request.resource.data.kycStatus in ['pending', 'not_submitted', 'KYC_DRAFT', 'unverified', 'resubmission'])
      );
      allow delete: if isAdmin();
    }
    match /seller_profiles/{sellerId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isOwner(sellerId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'kyc_status', 'payout_verified']) || 
         request.resource.data.kyc_status in ['pending', 'not_submitted', 'KYC_DRAFT', 'unverified', 'resubmission'])
      );
    }
    match /seller_verifications/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId) || isAdmin();
    }
    match /seller_settings/{sellerId} {
      allow read, write: if isOwner(sellerId) || isAdmin();
    }
    match /seller_payout_methods/{methodId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }
    match /payout_methods/{methodId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // 3. PRODUCTS & CATALOG DOMAIN
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /listings/{listingId} {
      allow read: if true;
      allow write: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
    }
    match /product_versions/{versionId} {
      allow read: if true;
      allow write: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. ORDERS & COMMERCE DOMAIN
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /order_items/{itemId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
    }

    // 5. FINANCE & LEDGER DOMAIN
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /commissions/{commId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow write: if isAdmin();
    }
    match /wallet_ledger/{ledgerId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /payout_requests/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.sellerId == request.auth.uid || request.resource.data.seller_id == request.auth.uid || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /refunds/{refundId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 6. KYC & COMPLIANCE DOMAIN
    match /kyc_submissions/{kycId} {
      allow read: if isOwner(kycId) || (resource != null && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid)) || isAdmin();
      allow create: if isOwner(kycId) || (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /kyc_applications/{kycId} {
      allow read: if isOwner(kycId) || (resource != null && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid)) || isAdmin();
      allow create: if isOwner(kycId) || (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /kyc_documents/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }
    match /user_kyc/{kycId} {
      allow read: if isOwner(kycId) || (resource != null && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid)) || isAdmin();
      allow create: if isOwner(kycId) || (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow update: if isOwner(kycId) || (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /kyc_reverification_requests/{reqId} {
      allow read: if isSignedIn() && (resource.data.seller_id == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /verification_records/{recId} {
      allow read, write: if isAdmin();
    }

    // 7. COMMUNICATION & NOTIFICATIONS
    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource == null || resource.data.senderId == request.auth.uid || resource.data.sender_id == request.auth.uid || resource.data.receiverId == request.auth.uid || resource.data.receiver_id == request.auth.uid || resource.data.recipient_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.senderId == request.auth.uid || request.resource.data.sender_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /direct_messages/{messageId} {
      allow read: if isSignedIn() && (resource == null || resource.data.sender_id == request.auth.uid || resource.data.recipient_id == request.auth.uid || resource.data.seller_id == request.auth.uid || resource.data.buyer_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.sender_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /conversations/{convId} {
      allow read: if isSignedIn() && (resource == null || (resource.data.participants != null && request.auth.uid in resource.data.participants) || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || resource.data.buyer_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && ((request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || request.resource.data.sellerId == request.auth.uid || request.resource.data.seller_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.participants != null && request.auth.uid in resource.data.participants) || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.seller_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid));
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // 8. SUPPORT & CMS & PROMOTIONS
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 9. SYSTEM SETTINGS & AUDIT LOGS
    match /countries/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /commission_settings/{commSettingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Default deny catch-all for any unlisted collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
