rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Single source of truth for authorized admin accounts (strictly synchronized with src/config/admin.ts)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'jagannathsing777@gmail.com',
          'admin.aurevyxon@gmail.com',
          'admin@aurevyxon.com'
        ]
      );
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/png') 
            || request.resource.contentType.matches('image/jpeg') 
            || request.resource.contentType.matches('image/jpg')
            || request.resource.contentType.matches('image/webp'));
    }

    function isValidDoc() {
      return request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/png') 
            || request.resource.contentType.matches('image/jpeg') 
            || request.resource.contentType.matches('image/jpg')
            || request.resource.contentType.matches('image/webp')
            || request.resource.contentType.matches('application/pdf'));
    }

    // 1. User Profile Avatar Storage (Public read, Owner/Admin write)
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
    }

    // 2. Seller Profile Avatar Storage (Public read, Owner/Admin write)
    match /sellers/{sellerId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == sellerId || isAdmin()) && isValidImage();
    }

    // 3. Admin Profile Avatar Storage (Public read, Admin write)
    match /admins/{adminId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // 4. KYC & Identity Verification Documents (STRICT PRIVATE: Only Document Owner or Admin)
    match /kyc/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidDoc();
    }
    match /kyc_documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidDoc();
    }

    // 5. Public Product Images (Public read, Authenticated Seller/Admin write)
    match /products/{sellerId}/images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == sellerId || isAdmin()) && isValidImage();
    }
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    // 6. Digital Product Asset Files (STRICT PRIVATE: Only Owner Seller or Admin)
    match /products/{sellerId}/assets/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == sellerId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == sellerId || isAdmin()) && request.resource.size < 100 * 1024 * 1024;
    }

    // 7. Support & Ticket Attachments (STRICT PRIVATE: Only Ticket Owner or Admin)
    match /tickets/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && request.resource.size < 25 * 1024 * 1024;
    }

    // Strict Default Deny for all other unlisted paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
